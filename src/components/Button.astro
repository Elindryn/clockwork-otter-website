---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;

const variantClasses =
  variant === "primary"
    ? "btn-primary bg-[var(--button-primary-background)] text-[var(--button-primary-text)] hover:bg-[var(--button-primary-background-hover)] active:bg-[var(--button-primary-background-active)]"
    : "border-[length:var(--border-width-medium)] border-[var(--button-secondary-border)] bg-transparent text-[var(--button-secondary-text)] hover:bg-[var(--button-secondary-background-hover)] focus-visible:outline-[length:var(--border-width-medium)] focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus-default)]";
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-[var(--button-radius)] px-6 py-3 font-body text-sm font-medium transition-colors duration-[var(--transition-fast)]",
    variantClasses,
  ]}
>
  <slot />
</a>

<style>
  /*
   * Two-tone halo for the primary variant, replacing the default outline
   * (see --color-focus-ring-* in tokens.css for the contrast reasoning).
   */
  .btn-primary:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-focus-ring-inner),
      0 0 0 4px var(--color-focus-ring-outer);
  }
</style>
