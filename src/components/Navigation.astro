---
import { Image } from "astro:assets";
import logo from "../assets/images/logo/clockwork-otter-logo-horizontal-white.svg";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/products", label: "Products" },
  { href: "/documentation", label: "Documentation" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header
  class="border-b-[var(--border-width-medium)] border-b-[var(--navigation-divider)]"
  style={`background-color: var(--navigation-background); height: var(--navigation-height);`}
>
  <nav
    class="mx-auto flex h-full max-w-[var(--content-max-width)] items-center justify-between px-6"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center" aria-label="Clockwork Otter Foundry — home">
      <Image src={logo} alt="Clockwork Otter Foundry" width={194} height={45} />
    </a>

    <ul class="flex items-center gap-8">
      {
        links.map((link) => {
          const active = isActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class="relative inline-flex h-[var(--navigation-height)] items-center font-body text-sm font-medium text-[var(--navigation-text)] transition-colors duration-[var(--transition-fast)] hover:text-[var(--navigation-hover)]"
              >
                {link.label}
                {active && (
                  <span
                    class="absolute inset-x-0 bottom-0 h-[var(--border-width-medium)] bg-[var(--navigation-active-indicator)]"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
