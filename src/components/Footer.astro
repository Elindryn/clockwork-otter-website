---
const year = new Date().getFullYear();

const links = [
  { href: "/", label: "Home" },
  { href: "/antiphon/", label: "Antiphon" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy Policy" },
  { href: "/terms/", label: "Terms of Use" },
];
---

<footer style={`background-color: var(--footer-background); color: var(--footer-text);`}>
  <div
    class="mx-auto flex max-w-[var(--content-max-width)] flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="font-body text-sm" style={`color: var(--footer-text-muted);`}>
      &copy; {year} Clockwork Otter Foundry. All rights reserved.
    </p>

    <ul class="flex flex-wrap gap-x-6 gap-y-3">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="footer-link inline-flex items-center px-2 py-3 font-body text-sm text-[var(--footer-text)] transition-colors duration-[var(--transition-fast)] hover:text-[var(--navigation-hover)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  /*
   * Same Charcoal-focus gap as Navigation.astro's links — the global
   * default focus outline (Copper) only measures 2.83:1 against the
   * footer's Charcoal background, below the 3:1 non-text minimum.
   */
  .footer-link:focus-visible {
    outline: var(--border-width-medium) solid var(--navigation-hover);
    outline-offset: 2px;
  }
</style>
