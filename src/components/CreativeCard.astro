---
import Button from "./Button.astro";

interface Props {
  title: string;
  /** Small uppercase label above the title. */
  kicker?: string;
  /** Semibold line directly under the title. */
  tagline?: string;
  /** One string per paragraph. */
  description: string[];
  /** Omit for a non-interactive "coming soon" row. */
  href?: string;
  linkLabel?: string;
  badge?: string;
}

const { title, kicker, tagline, description, href, linkLabel, badge } = Astro.props;
const quiet = !href;
---

<li
  class:list={[
    "flex flex-col gap-4 rounded-[var(--radius-card)] border-[length:var(--border-width-thin)] border-[color-mix(in_srgb,var(--color-text-secondary)_40%,transparent)] p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8",
    quiet
      ? "bg-transparent"
      : "bg-[var(--color-surface)] shadow-[var(--shadow-card,0_1px_3px_rgb(0_0_0/0.12))]",
  ]}
>
  <div class="flex flex-col gap-3">
    {
      (kicker || badge) && (
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs font-semibold tracking-wide text-[var(--color-text-secondary)] uppercase">
          {kicker && <span>{kicker}</span>}
          {badge && <span>{badge}</span>}
        </p>
      )
    }
    <h2 class="text-[var(--color-text-primary)]">{title}</h2>
    {tagline && <p class="font-semibold text-[var(--color-text-primary)]">{tagline}</p>}
    {description.map((paragraph) => <p class="text-[var(--color-text-secondary)]">{paragraph}</p>)}
  </div>
  {
    href && (
      <div class="shrink-0">
        <Button href={href} variant="primary">
          {linkLabel ?? title}
        </Button>
      </div>
    )
  }
</li>
