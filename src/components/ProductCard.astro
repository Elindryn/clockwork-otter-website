---
interface Props {
  name: string;
  description: string;
  href: string;
}

const { name, description, href } = Astro.props;
---

<div class="rounded-[var(--radius-card)] p-8" style={`background-color: var(--color-surface);`}>
  <h3>{name}</h3>
  <p class="mt-2 text-[var(--color-text-secondary)]">{description}</p>
  <a href={href} class="mt-4 inline-block font-body text-sm font-medium">Learn more</a>
</div>
