---
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CreativeCard from "../../components/CreativeCard.astro";
import otter from "../../assets/images/otter/otter-gear-toss.png";
import portrait from "../../assets/images/otter/otter-smug-mechanic.png";

// One <picture>: the gear-toss otter from md up, the smug portrait below it. The browser fetches only the matching source.
const wide = await getImage({ src: otter, widths: [320, 480, 640, 720], format: "webp" });
const narrow = await getImage({ src: portrait, widths: [288, 432, 576, 768], format: "webp" });
const srcset = (img: Awaited<ReturnType<typeof getImage>>) => img.srcSet.attribute;
---

<BaseLayout
  title="Creative"
  description="Creative work from Clockwork Otter Foundry: coloring books from Copper Leaf Editions, with Skylarking Coloring Co., Bardsong and Cauldron & Tome on the way."
>
  <article class="px-6 py-12 md:py-16">
    <div class="mx-auto max-w-[var(--content-max-width)]">
      <div
        class="grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-[clamp(14rem,24vw,20rem)_minmax(0,1fr)] md:pt-16"
      >
        <!-- Desktop: the wrapper is 60% of the image height and the image is lifted 40%, so his elbow rests on the first row's top edge. -->
        <!-- Narrow: the portrait is cropped to its top 80% and sits flush on the first row (-mb-12 cancels the grid gap), which covers the crop line. -->
        <div
          class="order-2 -mb-12 aspect-[1024/1229] w-[min(100%,17rem)] justify-self-center overflow-hidden md:relative md:order-none md:col-start-1 md:row-start-2 md:mb-0 md:aspect-[1024/922] md:w-full md:justify-self-auto md:overflow-visible"
        >
          <picture class="block">
            <source media="(min-width: 768px)" srcset={srcset(wide)} sizes="20rem" type="image/webp" />
            <img
              src={narrow.src}
              srcset={srcset(narrow)}
              sizes="17rem"
              width={portrait.width}
              height={portrait.height}
              alt="Clockwork Otter Foundry mascot: an otter in brass goggles and a leather vest."
              loading="eager"
              decoding="async"
              class="h-auto w-full object-top md:absolute md:top-0 md:left-0 md:w-[calc(100%+2.5rem)] md:max-w-none md:-translate-y-[40%]"
            />
          </picture>
        </div>
        <div class="order-1 max-w-[var(--reading-max-width)] md:order-none md:col-start-2 md:row-start-1">
          <h1>Creative</h1>
          <p class="mt-4 font-semibold text-[var(--color-text-primary)]">Where imagination takes shape.</p>
          <p class="mt-4 text-[var(--color-text-secondary)]">
            At Clockwork Otter Foundry, creativity is something to explore, build, and bring to life.
            Our creative work spans coloring books, imaginative storytelling, and digital tools for the
            worlds we dream up, and every project begins with curiosity and a passion for thoughtful
            craftsmanship.
          </p>
          <p class="mt-4 text-[var(--color-text-secondary)]">
            Different audiences. Different experiences. One shared belief: the best creative work invites
            you to make it your own.
          </p>
        </div>
        <ul class="relative z-10 order-3 flex flex-col gap-6 md:order-none md:col-start-2 md:row-start-2">
          <CreativeCard
            kicker="Adult coloring books"
            title="Copper Leaf Editions™"
            tagline="Artful escapes for curious minds."
            description={[
              "A line of coloring books for adults from Clockwork Otter Foundry, thoughtfully designed for people who enjoy exploring the extraordinary through art. Collections draw inspiration from the natural world, remarkable places, cultural traditions, historical curiosities, and the darker corners of imagination.",
              "Each book is built around a distinctive theme, and many pair detailed illustrations with short editorial notes that add context, history, or story to the artwork.",
            ]}
            href="/copper-leaf/"
            linkLabel="See the books"
          />
          <CreativeCard
            kicker="Coloring books for kids"
            title="Skylarking Coloring Co.™"
            badge="Coming soon"
            tagline="Big imaginations start with a little color."
            description={[
              "A line of coloring books themed for kids, from Clockwork Otter Foundry. Skylarking books are being designed to spark curiosity, encourage imagination, and make creative play feel welcoming and fun, with plenty of room for personal expression.",
              "Little hands. Big ideas. Endless possibilities.",
            ]}
          />
          <CreativeCard
            kicker="Tabletop roleplaying"
            title="Bardsong"
            badge="In development"
            tagline="Every great character has a story worth telling."
            description={[
              "An advanced character builder for tabletop roleplaying games. Bardsong is being designed to help players and game masters develop characters with distinctive personalities, histories, and a visual identity that stays recognizable as their stories continue.",
            ]}
          />
          <CreativeCard
            kicker="Tabletop roleplaying"
            title="Cauldron &amp; Tome"
            badge="In development"
            tagline="Build your world. Chronicle its stories."
            description={[
              "A worldbuilding and game-master workspace for tabletop roleplaying games. Cauldron & Tome is being built to bring a setting together in one place: realms, campaigns, characters, creatures, calendars, maps, and the lore that connects them, so the details that make a world feel alive are never lost.",
            ]}
          />
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>
