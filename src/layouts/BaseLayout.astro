---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
/*
 * og:image — pre-composited, not a live per-render transform. The source
 * (src/assets/images/logo/primarylogo.png) is a 660×844 portrait PNG
 * with transparency; astro:assets' getImage({fit: "contain", background})
 * was tried first but doesn't pad to the requested canvas in this Astro
 * version (it returns an image scaled to fit within the box, not a
 * full-size composite — verified: requesting 1200×630 produced 493×630).
 * og-image.jpg was generated once with sharp directly (the same library
 * Astro's own image service wraps) onto a 1200×630 Foundry Paper
 * background — regenerate with:
 *   node -e "require('sharp')('src/assets/images/logo/primarylogo.png').resize(1200,630,{fit:'contain',background:'#f7f7f5'}).flatten({background:'#f7f7f5'}).jpeg({quality:90}).toFile('src/assets/images/og-image.jpg')"
 * if primarylogo.png ever changes.
 */
import ogImage from "../assets/images/og-image.jpg";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Clockwork Otter Foundry", noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const pageTitle = `${title} · Clockwork Otter Foundry`;
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Fonts are self-hosted (Phase 5) — loaded via src/styles/global.css. -->
  </head>
  <body class="flex min-h-screen flex-col">
    <Navigation currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
